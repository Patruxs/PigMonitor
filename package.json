    "check": "npm run typecheck && npm run test && npm run bundle"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
