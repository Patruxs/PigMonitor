{
  "name": "pigmonitor",
  "version": "0.2.1",
  "description": "A Paseo plugin that shows your piggery agent teams inside Paseo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patruxs/PigMonitor.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"client/**/*.test.ts\" \"server/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run test && npm run bundle"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
