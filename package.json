{
  "name": "pigmonitor",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON shared/*.test.ts server/*.test.ts",
